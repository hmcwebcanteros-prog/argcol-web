---
import { SECTION_KEYS } from "../lib/site";

const path = Astro.url.pathname;

const isNotes =
  path.startsWith("/notas") ||
  path.startsWith("/archivo") ||
  path.startsWith("/etiqueta") ||
  path.startsWith("/buscar") ||
  SECTION_KEYS.some((key) => path.startsWith(`/${key}/`));

const isActive = (href: string) => {
  if (href === "/") return path === "/";
  if (href === "/notas/") return isNotes;
  return path.startsWith(href);
}

// Menú principal del family office.
// - "Access" quedó fuera a pedido del usuario.
// - Los enlaces a ae.argcol.com.ar se han reemplazado por navegación interna
//   acorde con la estructura del nuevo sitio (secciones + /notas/).
const links = [
  { href: "/", label: "Home" },
  { href: "/sobre/", label: "Sobre la Cía." },
  { href: "/notas/", label: "Notas" },
  { href: "/etiquetas/", label: "Etiquetas" },
  { href: "/mercado/", label: "Mercado" },
  { href: "/inversion/", label: "Inversión" },
  { href: "/economia/", label: "Economía" },
  { href: "/empresas/", label: "Empresas" },
  { href: "/ratios/", label: "Ratios" },
  { href: "/etf/", label: "ETF" },
  { href: "/contacto/", label: "Contacto" },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Argcol Capital — inicio">
      <span class="brand-mark" aria-hidden="true">AC</span>
      <span class="brand-text">
        <span class="brand-name">Argcol <em>Capital</em></span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Menú principal">
      {
        links.map((link) =>
          <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        )
      }
    </nav>
  </div>
</header>