---
import { SITE } from "../lib/site";

interface Props {
  headline?: string;
  text?: string;
}

const {
  headline = "El cierre del mercado, en tu correo",
  text = "Un envío breve cuando hay algo que vale la pena leer: el resumen de la rueda, una idea de inversión y los datos que importan. Gratis, sin publicidad y con baja en un clic.",
} = Astro.props;
---

<section class="newsletter" id="suscripcion">
  <div class="wrap newsletter-inner">
    <div>
      <span class="kicker">Newsletter</span>
      <h2>{headline}</h2>
      <p>{text}</p>
    </div>

    <div>
      <form class="newsletter-form" data-newsletter action={SITE.newsletter || undefined} method="post" novalidate>
        <label class="sr-only" for="nl-email">Correo electrónico</label>
        <input id="nl-email" type="email" name="email" required autocomplete="email" placeholder="tu@correo.com" />
        <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit">Suscribirme</button>
      </form>
      <p class="form-note">Sin spam. Podés darte de baja cuando quieras.</p>
      <p class="form-status" data-newsletter-status role="status" aria-live="polite"></p>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll("form[data-newsletter]").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = form.parentElement.querySelector("[data-newsletter-status]");
      const button = form.querySelector("button");
      const email = form.querySelector('input[name="email"]');
      if (!email || !email.value || !email.checkValidity()) {
        if (status) status.textContent = "Ingresá un correo válido.";
        email?.focus();
        return;
      }
      if (button) {
        button.disabled = true;
        button.textContent = "Enviando…";
      }
      try {
        const data = new FormData(form);
        await fetch(form.action, { method: "POST", body: data, mode: "no-cors" });
        if (status) status.textContent = "¡Listo! Revisá tu correo para confirmar la suscripción.";
        form.reset();
      } catch (error) {
        if (status) status.textContent = "No pudimos registrar el correo. Probá de nuevo.";
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = "Suscribirme";
        }
      }
    });
  });
</script>
