---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Newsletter from "../components/Newsletter.astro";
import { SECTIONS, SECTION_KEYS, SITE } from "../lib/site";
import { allPosts, formatDate, sectionPosts } from "../lib/posts";

const posts = await allPosts();
const featured = posts[0];
const latest = posts.slice(1, 7);

const sections = await Promise.all(
  SECTION_KEYS.map(async (key) => ({
    key,
    meta: SECTIONS[key],
    posts: (await sectionPosts(key)).slice(0, 3),
    total: (await sectionPosts(key)).length,
  })),
);

const today = formatDate(new Date());
const todayLabel = today.charAt(0).toUpperCase() + today.slice(1);
---

<Base title="Argcol Capital — Mercados, inversión y economía" description={SITE.description}>
  <div class="today-bar">
    <div class="wrap">
      <span><strong>{todayLabel}</strong> · Buenos Aires · Bogotá</span>
      <span class="today-tag">Análisis independiente</span>
    </div>
  </div>

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="kicker">Argentina + Colombia</span>
        <h1>Claridad para <em>decidir</em> mejor.</h1>
        <p class="hero-lead">
          Mercados, inversión, economía y empresas explicados sin humo. Análisis con
          datos, criterio de largo plazo y una mirada regional de Argentina y Colombia.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#ultimas">Leer las últimas entradas</a>
          <a class="btn btn-ghost" href="/sobre/">Quiénes somos</a>
        </div>
        <p class="hero-note">
          <span>{posts.length} entradas publicadas</span>
          <span>Sin publicidad</span>
          <span>Actualización continua</span>
        </p>
      </div>

      {featured && <Card post={featured} variant="feature" index={0} />}
    </div>
  </section>

  <div class="wrap">
    {latest.length > 0 && (
      <section class="block" id="ultimas">
        <div class="block-head">
          <div>
            <span class="kicker">Recién publicado</span>
            <h2>Últimas entradas</h2>
          </div>
          <a class="more-link" href="/archivo/">Ver el archivo completo →</a>
        </div>
        <div class="grid-3">
          {latest.map((post, index) => (
            <Card post={post} showSection index={index} />
          ))}
        </div>
      </section>
    )}

    <section class="block">
      <div class="block-head">
        <div>
          <span class="kicker">Explorar</span>
          <h2>Secciones</h2>
        </div>
      </div>
      <div class="section-cards">
        {sections.map((section) => (
          <a class="section-card" href={`/${section.key}/`}>
            <h3>{section.meta.label}</h3>
            <p>{section.meta.lead}</p>
            <span class="count">{section.total} textos</span>
          </a>
        ))}
      </div>
    </section>

    {sections
      .filter((section) => section.posts.length > 0)
      .map((section) => (
        <section class="block">
          <div class="block-head">
            <div>
              <span class="kicker">{section.meta.kicker}</span>
              <h2>{section.meta.label}</h2>
            </div>
            <a class="more-link" href={`/${section.key}/`}>
              Ver todo {section.meta.label} →
            </a>
          </div>
          {section.posts.length > 1 ? (
            <div class="grid-3">
              {section.posts.map((post) => (
                <Card post={post} />
              ))}
            </div>
          ) : (
            <div class="row-list">
              {section.posts.map((post) => (
                <Card post={post} variant="row" />
              ))}
            </div>
          )}
        </section>
      ))}
  </div>

  <Newsletter />
</Base>
